# A Devin v3 service-user credential or personal access token.
DEVIN_API_KEY=
DEVIN_ORG_ID=
PORT=4317
# Optional: absolute path when devin is not on PATH.
# DEVIN_CLI_PATH=/absolute/path/to/devin
# Optional: isolated profile. Omit to reuse normal `devin auth login` credentials.
# RELAY_DEVIN_DATA_HOME=/absolute/path/to/private/profile/data
# RELAY_DEVIN_CONFIG_HOME=/absolute/path/to/private/profile/config
